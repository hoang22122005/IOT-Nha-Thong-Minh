MQTT_USERNAME=esp32
MQTT_PASSWORD=PUT_THE_BROKER_PASSWORD_HERE
POSTGRES_PASSWORD=PUT_A_LONG_RANDOM_DATABASE_PASSWORD_HERE

# Set this to 8080 on a development computer. Leave unset on a VPS using port 80.
# BACKEND_PORT=8080
# BACKEND_BIND_ADDRESS=127.0.0.1

# Optional host ports; container-to-container ports remain unchanged.
# MQTT_HOST_PORT=1883
# MQTT_BIND_ADDRESS=0.0.0.0
# REDIS_HOST_PORT=6379
# MONGODB_HOST_PORT=27017
# POSTGRES_HOST_PORT=5433

# The VPS defaults to its own Mosquitto container. A local backend can instead
# subscribe to the VPS broker by setting this once in its own ignored .env.
# MQTT_BROKER_URL=tcp://YOUR_VPS_IP_OR_DOMAIN:1883

# Optional deployment identifiers and database names.
# IOT_HOME_ID=home-01
# IOT_ROOM_ID=room-01
# MONGODB_DATABASE=smarthome
# POSTGRES_DB=smarthome
# POSTGRES_USER=smarthome

# Optional comma-separated browser origins and backend log levels.
# IOT_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://YOUR_VPS_IP_OR_DOMAIN
# IOT_LOG_LEVEL=INFO
# SPRING_WEB_LOG_LEVEL=WARN
# SPRING_WS_LOG_LEVEL=WARN
