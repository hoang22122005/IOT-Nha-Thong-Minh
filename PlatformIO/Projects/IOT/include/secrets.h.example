#pragma once

// Copy this file to secrets.h and enter credentials for your own trusted LAN.
// The real secrets.h is ignored by Git; never commit Wi-Fi or MQTT passwords.
#define WIFI_SSID "YOUR_2_4_GHZ_WIFI_NAME"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// Broker address:
// - Set MQTT_HOST to your server's Public IP or domain (e.g. "168.107.75.167") for Cloud deploy.
// - Or leave it as empty ("") if you want ESP32 to auto-discover the broker on local /24 LAN.
#define MQTT_HOST "168.107.75.167"
#define MQTT_PORT 1883
#define MQTT_USERNAME "esp32"
#define MQTT_PASSWORD "YOUR_MQTT_PASSWORD"

// Default identifiers for node 1. PlatformIO build profiles may override them.
#ifndef IOT_DEVICE_ID
#define IOT_DEVICE_ID "esp32-room-01"
#endif
#ifndef IOT_HOME_ID
#define IOT_HOME_ID "home-01"
#endif
#ifndef IOT_ROOM_ID
#define IOT_ROOM_ID "room-01"
#endif
#ifndef IOT_SENSOR_ID
#define IOT_SENSOR_ID "dht11-01"
#endif
